---
/**
 * The last thing on every page, under the call to action: the Riyo monogram
 * held large at the bottom left corner, with the ways of reaching the studio
 * stacked to the right of it.
 *
 * It is uncovered rather than scrolled to. The footer sits still against the
 * bottom of the screen while the page slides off it, so the grey comes up from
 * under the call to action like a layer that was always there — which is also
 * why it is the grey it is: the same ink as the grid hairlines, the page's own
 * substrate showing through. See `.footer-reveal` in the stylesheet.
 *
 * The two are a flex row aligned to its start, which is what puts the first
 * line of text level with the top of the mark: one alignment does both jobs,
 * since the mark is the taller of the two and so sets the row's height. The
 * mark then finishes the page — the footer has no bottom padding, so its feet
 * are the last pixels of the document.
 *
 * The links are content: the email and the two profile URLs come from
 * siteSettings, and any of them that the dataset has not been given is left
 * out rather than rendered as a link to nowhere. Like ContactCta, the content
 * is a prop with a fetching default, so the three routes that render a footer
 * do not each have to ask for it.
 */
import { getFooterSection, type FooterSection } from "../../lib/sanity";
import VerticalEdges from "../ui/VerticalEdges.astro";

interface Props {
  content?: FooterSection;
}

const { content = await getFooterSection() } = Astro.props;

const links = [
  content.contactEmail && {
    label: content.contactEmail,
    href: `mailto:${content.contactEmail}`,
    external: false,
  },
  content.linkedinUrl && {
    label: "LinkedIn",
    href: content.linkedinUrl,
    external: true,
  },
  content.instagramUrl && {
    label: "Instagram",
    href: content.instagramUrl,
    external: true,
  },
].filter((link): link is { label: string; href: string; external: boolean } =>
  Boolean(link),
);
---

{/* The window the footer is seen through. It is an ordinary block in flow, so
    the document reserves exactly the footer's own height for it — the rise
    below is paint, not layout, and needs no measurement to be kept in step
    with. */}
<div class="footer-reveal">
  <footer class="footer">
    {/* The mark is painted rather than placed: the asset's own fill is white,
        and the colour it is drawn in here is a decision the design tokens own,
        so the file is used as a mask and the token is what fills it. Decorative
        either way — the copyright line beside it already names the studio in
        text, so there is nothing here for a reader who cannot see it. */}
    <span class="footer__logo" aria-hidden="true"></span>

    <div class="footer__meta">
      {
        links.map((link) => (
          <a
            class="footer__link"
            href={link.href}
            data-coord-snap
            {...(link.external
              ? { target: "_blank", rel: "noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        ))
      }
      <p class="footer__copyright">
        &copy; {new Date().getFullYear()} Riyo Productions
      </p>
    </div>

    <VerticalEdges />
  </footer>
</div>

<script>
  /**
   * How far the footer is lifted inside its window, which is the whole of the
   * reveal: everything else is the clip in the stylesheet.
   *
   * The lift is the page's remaining scroll. The window's bottom edge is the
   * last pixel of the document, so the distance from it to the bottom of the
   * screen is exactly what is left to scroll — and lifting the footer by that
   * much is what parks its feet on the bottom of the screen and keeps them
   * there. It reaches zero at the end of the page, where the footer is back in
   * its own box and the clip has nothing left to cut.
   *
   * Read every frame rather than cached: the footer's height moves under us as
   * the brand font swaps in and as the window is resized, and re-reading one
   * rect costs less than watching for either.
   *
   * The other half of the file is the nudge that finishes the reveal the
   * moment the footer is reached; see `NUDGE_DURATION` below.
   */
  const reveal = document.querySelector<HTMLElement>(".footer-reveal");
  const footer = reveal?.querySelector<HTMLElement>(".footer");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (reveal && footer) {
    /**
     * The nudge.
     *
     * The reveal finishes itself. Once the reader has opened half the footer
     * the page adds to the movement they already have, and the footer lands
     * filling the screen without them having to carry it the rest of the way.
     * Half, because that is the point past which they have plainly chosen to
     * be here rather than glanced at it on the way somewhere.
     *
     * It is a push, not a takeover, and that distinction is the whole
     * implementation. Lenis is always lerping its scroll toward a target, and
     * a wheel event is nothing more than `targetScroll + delta` — so this does
     * the same thing, in `programmatic: false` mode, which is the wheel's own
     * path through `scrollTo`. Three things follow from that, and all three
     * were the bugs in the version before it:
     *
     *  - It cannot be cancelled, because it is not an animation to cancel. A
     *    programmatic `scrollTo` is replaced outright by the next wheel event,
     *    and a trackpad throws a second of momentum events after the fingers
     *    lift — so the old assist was being thrown away a frame or two after
     *    it fired, which is why it looked like it never ran.
     *  - It has no handover. There is no second easing curve starting at its
     *    own speed against the reader's; the target moved, and the same lerp
     *    that was already carrying them keeps carrying them. The old curve
     *    was an expo-out, which leaves the line at about seven times its
     *    average speed — a jerk against anyone scrolling slower than that,
     *    which was the abruptness.
     *  - It stays interruptible. Scrolling up during it simply moves the
     *    target back, and Lenis drops the curve for its own lerp — nothing
     *    here has to watch for that or unwind itself.
     *
     * The shape of it is `cubic-bezier(0.77, 0, 0.175, 1)` over
     * `NUDGE_DURATION` — an ease-in-out that leaves slowly, sweeps through the
     * middle, and settles. It is handed to Lenis as the animation's own
     * easing rather than approximated by dripping the distance in over frames,
     * which is what the version before this did and why it could only ever be
     * roughly a curve.
     *
     * Committing the destination is what survives the reader's momentum. On
     * the `programmatic: false` path Lenis sets `targetScroll` to the end of
     * the page before the animation starts and leaves it there, so a wheel
     * event arriving mid-nudge adds its delta to a target that already has the
     * whole nudge in it. The curve can be overridden — Lenis will lerp the
     * rest of the way instead — but the destination cannot be lost, which is
     * the difference between this and a plain `scrollTo`.
     */
    const NUDGE_DURATION = 0.9;

    /**
     * Solves a CSS cubic-bezier for y at a given x, the way a browser does:
     * Newton-Raphson on the x polynomial to recover the curve parameter, then
     * the same polynomial on y. Eight passes is what WebKit settles for and is
     * far inside a pixel at this distance.
     */
    const cubicBezier = (x1: number, y1: number, x2: number, y2: number) => {
      const a = (u: number, v: number) => 1 - 3 * v + 3 * u;
      const b = (u: number, v: number) => 3 * v - 6 * u;
      const c = (u: number) => 3 * u;
      const at = (t: number, u: number, v: number) =>
        ((a(u, v) * t + b(u, v)) * t + c(u)) * t;
      const slope = (t: number, u: number, v: number) =>
        3 * a(u, v) * t * t + 2 * b(u, v) * t + c(u);

      return (x: number) => {
        if (x <= 0) return 0;
        if (x >= 1) return 1;
        let t = x;
        for (let pass = 0; pass < 8; pass += 1) {
          const d = slope(t, x1, x2);
          if (d === 0) break;
          t -= (at(t, x1, x2) - x) / d;
        }
        return at(t, y1, y2);
      };
    };

    const NUDGE_CURVE = cubicBezier(0.77, 0, 0.175, 1);

    /**
     * The curve above is an ease-in-out, so it leaves from a standstill — and
     * the reader is not at a standstill when it fires. Handing Lenis that
     * curve raw means the first frame moves a fifth of a pixel where the frame
     * before it moved fifteen, which is a hard stop dressed up as an
     * animation. That is the abruptness: not the nudge being too sharp, the
     * nudge braking them to nothing before it starts.
     *
     * So the curve is given the reader's own speed to leave on. `carry` adds a
     * term that starts at exactly their velocity and decays away, leaving the
     * requested shape to do the rest:
     *
     *   E(t) = B(t) + s · t · (1 - t)³
     *
     * `s` is that velocity expressed in the curve's own units — how far along
     * it would travel per unit time if it kept going at their speed — so the
     * animation departs at the pace it took over from and eases into the
     * sweep rather than interrupting it. The term is zero at both ends, so the
     * nudge still lands exactly on the end of the page and still settles the
     * way `cubic-bezier(0.77, 0, 0.175, 1)` settles.
     *
     * It costs nothing when there is nothing to carry: a reader who has
     * drifted to the mark rather than travelled to it has `s` near zero, and
     * the curve is then the requested one unmodified.
     *
     * `CARRY_MAX` is where it stops honouring the handover — past it the carry
     * term would be most of the curve and the shape would stop being the one
     * asked for, so a hard fling gets a softened brake instead of none.
     */
    const CARRY_MAX = 2;

    const carry = (speed: number) => (t: number) =>
      NUDGE_CURVE(t) + speed * t * (1 - t) ** 3;

    /**
     * Both the reveal and the nudge are reserved for a pointer, and for the
     * same underlying reason: on a touch device the page is not scrolled by
     * anything this file can keep step with.
     *
     * The reveal is a transform recomputed from `scroll` events on the main
     * thread. A touch scroll is run by the compositor, which does not wait for
     * that thread and does not have to — so the footer is positioned from a
     * scroll offset that is already stale by the time it paints, and it
     * shivers against a page moving perfectly smoothly underneath it. Nothing
     * about the arithmetic fixes this; it is which thread the two things live
     * on.
     *
     * The lurches on top of the shiver are the address bar. `remaining` is
     * measured against `window.innerHeight`, and that changes by the height of
     * the browser chrome the moment it collapses — 90px on a phone, which is
     * 90px of footer applied to a single frame, mid-scroll, in the middle of a
     * gesture.
     *
     * Both of those are fixed by not being on this thread, which is what the
     * stylesheet's scroll-driven animation does and why it is preferred
     * wherever it exists. This gate is what is left for the browsers that
     * cannot: there, touch keeps a plain footer at the end of a page, which
     * the platform scrolls flawlessly. The nudge stands down on touch for a
     * different reason and keeps standing down either way: with Lenis' `syncTouch` off — the default, and what this page
     * runs — touch scrolling is the platform's own and Lenis is only watching
     * it, so moving its target mid-fling fights the OS for the position rather
     * than adding to it.
     */
    const fine = window.matchMedia("(pointer: fine)");

    /**
     * Whether the browser can run the reveal itself, on the compositor, from
     * the scroll-driven animation in the stylesheet. Where it can, it does,
     * and none of the arithmetic below runs at all — the animation is the
     * better version of it on every device, and the only version that survives
     * a touch scroll.
     */
    const composited = CSS.supports("animation-timeline", "view()");

    /**
     * Whether the script has to drive the reveal instead. Still reserved for a
     * pointer: on a browser without scroll-driven animations, a touch scroll
     * would get back exactly the shiver and the address-bar lurches this gate
     * was put here for, and no reveal at all is better than that one.
     */
    const drivable = () => !composited && !reduced.matches && fine.matches;

    const measure = () => {
      const box = reveal.getBoundingClientRect();
      const remaining = Math.max(0, box.bottom - window.innerHeight);
      // `opened` is how much of the footer is on screen: zero as its top edge
      // reaches the bottom of the screen, its full height at the end of the
      // page. The nudge fires at half of it.
      return { height: box.height, remaining, opened: box.height - remaining };
    };

    const rise = () => {
      if (!drivable()) {
        footer.style.removeProperty("--footer-rise");
        return;
      }
      footer.style.setProperty("--footer-rise", `${-measure().remaining}px`);
    };

    /**
     * Armed from wherever the page happens to start, so a reload already in
     * the footer does not push the reader the moment it loads. It re-arms as
     * soon as the footer is off the bottom of the screen again — every arrival
     * gets the nudge, not just the first.
     */
    const COMPLETE_AT = 0.5;
    const REARM_AT = 0.4;
    let armed = measure().opened < measure().height * COMPLETE_AT;

    const nudge = () => {
      const { height, opened, remaining } = measure();
      if (height <= 0) return;

      if (!armed) {
        if (opened < height * REARM_AT) armed = true;
        return;
      }
      if (opened < height * COMPLETE_AT || remaining <= 0) return;
      if (reduced.matches || !fine.matches || !window.lenis) return;

      const lenis = window.lenis;
      const distance = lenis.limit - lenis.animatedScroll;
      if (distance <= 0) return;

      // Lenis counts velocity per frame; the curve is parameterised in the
      // whole distance over the whole duration, so it is seconds either side.
      const speed = Math.min(
        Math.max((lenis.velocity * 60 * NUDGE_DURATION) / distance, 0),
        CARRY_MAX,
      );

      armed = false;
      lenis.scrollTo(lenis.limit, {
        programmatic: false,
        duration: NUDGE_DURATION,
        easing: carry(speed),
      });
    };

    let queued = false;
    const schedule = () => {
      // Bail before asking for the frame rather than inside it: where neither
      // half of this has anything to do, the cheapest thing a scroll handler
      // can do is not schedule work at all. The nudge still needs frames on a
      // pointer even when the browser is drawing the reveal itself.
      if (queued || (!drivable() && !fine.matches)) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        rise();
        nudge();
      });
    };

    rise();
    window.addEventListener("scroll", schedule, { passive: true });
    // Not `schedule`: a resize changes the footer's height under the mark, and
    // running the assist off that would finish the reveal for a reader who
    // only turned their phone over.
    window.addEventListener(
      "resize",
      () => {
        rise();
        const { height, opened } = measure();
        if (height > 0) armed = opened < height * COMPLETE_AT;
      },
      { passive: true },
    );
    reduced.addEventListener("change", rise);
    // A mouse plugged into a tablet, or unplugged from one, moves this page in
    // and out of being drivable; `rise` puts the footer back either way.
    fine.addEventListener("change", rise);
  }
</script>

<style>
  /* The reveal.
     ─────────
     The footer is uncovered rather than scrolled to: it holds still against
     the bottom of the screen while the page above slides off it, so the grey
     grows upward out from under the call to action.

     This is one clip and one translate, and no change to the page's layering.
     A `position: fixed` footer with the page painted over it would be the
     usual way, and it would cost the whole document an opaque background —
     which is the one thing the coordinate crosshair needs it not to have (see
     CoordinateCursor.astro, whose lines sit at z-index -1 and show through
     everything that has no background of its own).

     So the window is this box, an ordinary block in flow, and the footer
     inside it is lifted by however far the page has left to scroll — which is
     exactly the amount that puts its feet on the bottom of the screen. The
     window clips what the lift pushes out the top. Since the lift is a
     transform it takes no part in layout, so the box is still the footer's own
     height and nothing here has to be measured or kept in step.

     Without the script the rise is 0 and this is a footer at the end of a
     page, which is what it was. */
  .footer-reveal {
    /* For the shadow below, which is positioned against this box. */
    position: relative;
    overflow: clip;
  }

  /* The shadow the page casts on the footer.
     ───────────────────────────────────────
     The reveal says the footer is underneath; this is the page above agreeing
     with it. A soft edge of shade along the top of the grey, as if the section
     that ends there were a sheet lying a little in front rather than a section
     that simply stops.

     It hangs off the window rather than the footer, and that is the whole
     trick of it. The footer is lifted inside the window by the reveal — it is
     the one thing here that moves — so a shadow drawn on it would ride up and
     out through the top as the reader scrolled. The window does not move
     relative to the page, so a shadow pinned to its top edge stays welded to
     the seam the section above leaves, at every point in the reveal and at
     rest.

     `::after` rather than a background on the window, because the footer is a
     positioned child and would paint straight over one. Generated last, it
     lands above the footer without anyone needing a z-index.

     The falloff is `0.3 · (1 - y)²`, written out as stops. Two properties of
     that curve are doing the work, and the version before this had neither:

     It lands flat. A gradient's last segment is a straight line, so a ramp
     that simply runs out arrives at nothing still descending, and the eye
     reads the corner where it stops as an edge — the transition was ending on
     a line rather than fading past one. Squared, the slope reaches zero at the
     same moment the shade does, and there is no corner left to find.

     And it is spread. The shade is still doing something at 83% of the depth,
     against 63px of total travel before, so the tail has somewhere to
     disappear into. The steepest change anywhere along it is now 0.19 of an
     8-bit value per pixel, against 0.457 — less than half the rate, which is
     the difference between a shadow and a seam.

     Nine stops rather than three. The browser interpolates linearly between
     stops, so the curve is only ever a chain of straight segments; at nine it
     is within 0.0012 of the real one, which is a sixteenth of a value and well
     under anything that could show. The chromatic noise above sits at about
     five values of per-channel spread, so it dithers the whole ramp — banding
     across a gradient this shallow would otherwise be the next thing to go
     looking for.

     It runs the full width and costs nothing doing so — over the black margins
     it is black on black. */
  .footer-reveal::after {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(120px, 18vh, 220px);
    background-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.3) 0%,
      rgb(0 0 0 / 0.23) 12.5%,
      rgb(0 0 0 / 0.169) 25%,
      rgb(0 0 0 / 0.117) 37.5%,
      rgb(0 0 0 / 0.075) 50%,
      rgb(0 0 0 / 0.042) 62.5%,
      rgb(0 0 0 / 0.019) 75%,
      rgb(0 0 0 / 0.005) 87.5%,
      rgb(0 0 0 / 0) 100%
    );
    pointer-events: none;
  }

  .footer {
    transform: translateY(var(--footer-rise, 0px));
  }

  /* The reveal, off the main thread.
     ──────────────────────────────
     Everything above describes the lift the script performs. This performs the
     same lift and the browser runs it, which is the only version of it that
     holds together on a phone: a touch scroll belongs to the compositor, and a
     transform recomputed from `scroll` events on the main thread is always
     answering a question about where the page was, not where it is. That gap
     is the shiver. A scroll-driven animation is evaluated on the same thread
     that does the scrolling, so there is no gap to see.

     It is not a mobile special case — where the browser has this, it drives
     the reveal everywhere, and the script stands down entirely (see
     `composited` in the script). Desktop gets the same benefit; it just had
     less to gain, because a wheel scroll goes through the main thread anyway.

     `entry-crossing` is the range, and it is the whole reason this maps onto
     the script's arithmetic exactly. It runs from the window's top edge
     reaching the bottom of the screen to its bottom edge reaching the bottom
     of the screen — which is the script's `remaining` going from the footer's
     full height to nothing. `entry` is the near miss to avoid: for a subject
     taller than the screen it ends somewhere else entirely, and the footer is
     taller than the screen on a short window.

     The timeline is named off the window rather than taken from `view()` on
     the footer itself. The footer is the element being transformed, and a
     timeline read from the thing the animation moves is a question with a
     circular answer — even where the spec says layout wins, it is not worth
     depending on. The window does not move. */
  @supports (animation-timeline: view()) {
    .footer-reveal {
      view-timeline-name: --footer-reveal;
    }

    /* Longhands, and they have to stay longhands.
       ─────────────────────────────────────────
       `animation-timeline` is deliberately not part of the `animation`
       shorthand — the shorthand *resets* it to `auto`, so it could never
       legally carry one. Lightning CSS, which is what Vite minifies with,
       implements an earlier draft in which it was, and folds any
       `animation-timeline` sitting beside an `animation` shorthand into it:

         animation: footer-reveal linear both;   ->  animation: linear both
         animation-timeline: --footer-reveal;        footer-reveal --footer-reveal

       which no browser parses, so the whole declaration is dropped and the
       reveal silently does not exist. It only bites in production, because
       dev serves this unminified.

       Written as longhands there is no shorthand for it to fold into and the
       declarations survive verbatim — checked against the installed minifier.
       Do not condense these back into `animation:`. */
    .footer {
      animation-name: footer-reveal;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --footer-reveal;
      animation-range: entry-crossing;
    }

    /* -100% of the footer's own height, which is the window's height, which is
       the distance the script calls `remaining` at the start of the reveal. */
    @keyframes footer-reveal {
      from {
        transform: translateY(-100%);
      }

      to {
        transform: translateY(0);
      }
    }
  }

  /* Scroll-linked movement, so it comes off with the rest of it — both the
     script's version and the browser's. */
  @media (prefers-reduced-motion: reduce) {
    .footer {
      transform: none;
      /* `animation-name`, not the `animation` shorthand — see the note above
         on what the minifier does when it finds one of those here. */
      animation-name: none;
    }
  }

  /* A screenful less the hairline above it, so that scrolling to the end of
     the page puts the rule on the viewport's top edge and the footer under it
     fills everything below: the rule and the footer together are the screen.
     Without the subtraction the footer alone is the screen and the rule sits
     one pixel off the top of it, which is one pixel out of view.

     `lvh` rather than `vh` or `svh`: it is the viewport with the browser's own
     chrome collapsed, which on a phone is the state it is in by the time the
     reader has scrolled this far. `svh` would leave a sliver of the section
     above still showing, and `dvh` would resize the footer while the toolbars
     animate. The plain `vh` before it answers where `lvh` does not.

     Grid rather than flex, because the two alignments this needs are on the
     same axis and only grid can hold both: `align-content: end` drops the row
     to the bottom of that screenful so the mark's feet close the page, and
     `align-items: start` then lands the first line of text exactly on the top
     of the mark, which is the taller of the two and so sets the row's height.
     Flex has one `align-items` to spend and would have to choose. */
  .footer {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: end;
    align-items: start;
    column-gap: clamp(200px, 24vw, 500px);
    min-height: calc(100vh - var(--border-hairline-width));
    min-height: calc(100lvh - var(--border-hairline-width));
    /* The hairline ink itself, not a shade mixed to match it: laid over the
       page's own background it composites to exactly the grey the section
       rules and the vertical edges are drawn in, and it goes on tracking them
       if that ink is ever retuned. Being an ink rather than a colour is also
       what keeps this footer's own VerticalEdges visible on top of it — the
       two coats of paper-at-19% compose to a brighter line, the same way a
       crossing pair does anywhere else on the page. */
    background-color: var(--border-hairline);
    /* Only bites on a viewport too short to hold the mark, where the footer
       grows past the screenful and the rule above it needs clearing. */
    padding: clamp(48px, 6vw, 96px) var(--grid-margin) 0;
    /* Unconditional, so the noise below always has this footer to blend
       against and nothing behind it: without it the stacking context would be
       the reveal's transform, which is not there under reduced motion. */
    isolation: isolate;
  }

  /* The grey stops at the grid.
     ──────────────────────────
     Above the phone breakpoint the footer's ink is pulled in to the two
     vertical hairlines, and the margins outside them are left as the page's
     own black — so the field reads as the grid filled in rather than as a
     band laid across the whole width, and the rules bound it the way they
     bound every other section's content.

     A gradient rather than a second element or `background-clip`. Clipping to
     the content box would take the top padding with it and leave a black strip
     above the mark as well, which is the one edge that has to stay closed.
     The stops are doubled at each margin so there is no interpolation between
     them at all — a hard edge, not a two-pixel ramp — and the outer colour is
     paper at zero rather than `transparent`, which is the same thing said in
     the palette's own terms.

     `--surface-page` underneath is what the hairline ink then composites
     against, so the band is the exact grey it was when the whole footer
     carried it. Below the breakpoint the vertical rules are dropped (see
     VerticalEdges) and there is no grid left to stop at, so the ink goes back
     to running the full width. */
  @media (min-width: 700px) {
    .footer {
      background-color: var(--surface-page);
      background-image: linear-gradient(
        to right,
        rgb(var(--color-paper-rgb) / 0) var(--grid-margin),
        var(--border-hairline) var(--grid-margin),
        var(--border-hairline) calc(100% - var(--grid-margin)),
        rgb(var(--color-paper-rgb) / 0) calc(100% - var(--grid-margin))
